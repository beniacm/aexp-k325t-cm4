## Amiga 500 for MEGA65 (AExp)
##
## Core specific constraints (K325T copy of CORE/CORE.xdc for the stoppable clock, stall_clk.vhd)
##
## This machine is based on Minimig-AGA_MiSTer (MiSTer-devel/Minimig-AGA_MiSTer)
## Powered by MiSTer2MEGA65
## MEGA65 port done in 2026 and licensed under GPL v3


## Name Autogenerated Clocks
## Important: Using them in subsequent statements, e.g. clock dividers requires that they
## have been named/defined here before
## otherwise Vivado does not find the pins)
##
## main_clk is the Amiga's core clock (PAL 28.37516 MHz, -5.6 ppm). Everything in the core
## runs on it; the 7.09 MHz bus timing is made of clock enables (amiga_clk.v), and
## cpu_wrapper.v contains a (pruned with cpucfg=00) negedge-clk FSM - both edges of main_clk
## are therefore timed automatically.
##
## K325T (A1200/DDR3 study, stage 1): the stoppable Amiga clock, K325T/stall_clk.vhd.  ONE MMCM
## output (VCO 1135 MHz / 36.25 = 31.310 MHz = 28.375 x 32/29; stage 1: / 38.75) drives two global buffers: a BUFG
## (the ungated source clock of the stall/catch-up controller, stall_ctrl.vhd) and a BUFGCE (main_clk,
## the machine clock; CE = a register in the source clock).  Both carry the same clock object
## "main_clk" (period 31.94 ns): every path between the controller and the Amiga is synchronous, the
## BUFGCE CE pin is checked against I.  A gated main_clk only ever has FEWER edges than this clock,
## so the constraint is conservative.  The flicker-free twin MMCM and its BUFGMUX_CTRL are gone (the
## flicker-free FSM selects the controller's rate), and with them the set_case_analysis of CORE.xdc.
create_generated_clock -name main_clk [get_pins CORE/clk_gen/i_clk_main/CLKOUT0]
## the flicker-free select (hr_clk register) into the controller: a 2-FF synchroniser
set_max_delay 10 -datapath_only -from [get_cells CORE/hr_core_speed_reg[0]] \
    -to [get_cells CORE/clk_gen/i_stall_ctrl/fast_s1_reg]
# Add more clocks here, if needed

## ascal asynchronous FIFO data crossings (framework paths, constrained here
## because M2M/common.xdc must not be modified - candidate for upstreaming).
##
## ascal's input and output double buffers (i_dpram/o_dpram, explicitly kept
## in LUTRAM with ram_style="distributed") are ping-pong CDC FIFOs: i_dpram
## is written on i_clk (= main_clk) and read on avl_clk (= hr_clk); o_dpram is
## written on avl_clk and read on o_clk (= hdmi_clk). The handshake registers
## are already cut by the false_path patterns in M2M/common.xdc:113-117, but
## those match only register /C pins. The LUTRAM primitives launch from their
## /CLK pins and were therefore timed at the worst-case edge alignment of
## unrelated MMCM outputs (44 ps / 34 ps requirements, impossible by
## construction). Worse, the router inserted large hold-fix detours on these
## paths, which polluted the genuine intra-hr_clk setup paths (first R3 run:
## WNS -6.7 ns).
##
## set_max_delay -datapath_only bounds the data staleness to one destination
## clock period and removes the hold analysis (and with it the detours).
set_max_delay -datapath_only 10.000 \
   -from [get_pins -hierarchical -regexp {.*/i_ascal/i_dpram_reg.*/CLK}] \
   -to   [get_cells -hierarchical -regexp {.*/i_ascal/avl_dr_reg\[[0-9]+\]}]
set_max_delay -datapath_only 13.400 \
   -from [get_pins -hierarchical -regexp {.*/i_ascal/o_dpram_reg.*/CLK}] \
   -to   [get_cells -hierarchical -regexp {.*/i_ascal/o_dr_reg\[[0-9]+\]}]

## Notes for timing review after the first synthesis (do not enable blindly):
## - rtl/minimig_m68k_bridge.v uses a logic signal (_as_and_cs) as an async
##   preset (infers FDPE) - check the timing report for it.
## - rtl/paula_floppy.v has 'posedge clk or negedge IO_ENA' blocks. Since the
##   ADF floppy milestone, IO_ENA (= IO_FPGA) is LIVE: it is driven by a
##   plain main_clk register in adf_track_engine.vhd (io_fpga_o, no
##   combinational gating), so the async CLR pins get same-clock
##   recovery/removal checks that Vivado analyzes automatically - verify
##   them in the timing report of every build.

## K325T stage 2: chip_cache.vhd -- miss request (source clock, held stable while the toggle
## handshake is open) to the fill engine (MIG ui_clk) and the acknowledge toggle back
set_max_delay 10 -datapath_only -from [get_cells -hierarchical -filter {NAME =~ CORE/i_chip_cache/r_* || NAME =~ CORE/i_chip_cache/req_tgl_reg}] \
    -to [get_clocks clk_pll_i]
## and back (stage 2b): the job-done toggle and the Gray-coded beat count
set_max_delay 10 -datapath_only -from [get_cells -hierarchical -filter {NAME =~ CORE/i_chip_cache/done_tgl_reg || NAME =~ CORE/i_chip_cache/bcnt_g_reg*}] \
    -to [get_cells -hierarchical -filter {NAME =~ CORE/i_chip_cache/done_s1_reg || NAME =~ CORE/i_chip_cache/bc_s1_reg*}]
## stage 2b: the Kickstart load port of chip_cache.vhd -- QNICE byte (address, data, toggle; held
## while the toggle is open) to the ui_clk side, and the acknowledge toggle back
set_max_delay 10 -datapath_only -from [get_cells -hierarchical -filter {NAME =~ CORE/i_chip_cache/q_tgl_reg || NAME =~ CORE/i_chip_cache/q_a_reg* || NAME =~ CORE/i_chip_cache/q_d_reg*}] \
    -to [get_clocks clk_pll_i]
set_max_delay 10 -datapath_only -from [get_cells -hierarchical -filter {NAME =~ CORE/i_chip_cache/q_ack_reg}] \
    -to [get_cells -hierarchical -filter {NAME =~ CORE/i_chip_cache/qack_s1_reg}]
## stage 2b: audio_fifo.vhd -- the write pointer (main_clk, Gray) to the source clock (same tree,
## but the FIFO treats them as unrelated) and the M2M reset into main_clk
set_max_delay 32 -datapath_only -from [get_cells -hierarchical -filter {NAME =~ CORE/i_audio_fifo/wp_g_reg*}] \
    -to [get_cells -hierarchical -filter {NAME =~ CORE/i_audio_fifo/wp_s1_reg*}]
