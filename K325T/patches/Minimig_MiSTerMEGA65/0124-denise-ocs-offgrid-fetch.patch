+            ocs_third_pf1_done <= 1'b1;
+            ocs_third_pf2_done <= 1'b1;
+            ocs_handoff_done <= 1'b1;
+            ocs_delayed_ownership_latched <= 1'b0;
+            ocs_delayed_ownership_enable <= 1'b0;
