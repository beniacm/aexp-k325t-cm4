   output  reg dmareq,        //dma request
   output  reg dmas,        //dma special (restart)
-  input  strhor          //horizontal strobe
+  input  strhor,          //horizontal strobe
+  output [127:0] dbg       // K325T a1200-audrec: state for the audio flight recorder (aud_rec.v)
 );
 
 //register names and addresses
@@ -471,5 +472,9 @@
 end
 
 
+// K325T a1200-audrec (2026-11-14): the channel's state for the audio flight recorder (K325T/aud_rec.v)
+assign dbg = {5'd0, penhi, auddat, datbuf, audvol, audlen, audper, lencnt, percnt, intreq2, dmas, dmareq,
+              AUDxDAT, silence_d, silence, intpen, dmaena, sample, audio_state};
+
 endmodule
 
