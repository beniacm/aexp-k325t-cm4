K325T: port of MiSTer-devel/Minimig-AGA_MiSTer 56ba962 (class b: changes OCS/ECS behaviour)
"gary: keep the custom register mirror at $C00000-$D7FFFF" (#254): with 0119, Kickstart 1.2 sized
phantom slow RAM; the mirror stays where no slow RAM is configured, $D80000-$DEFFFF unmapped.
--- a/rtl/gary.v
+++ b/rtl/gary.v
@@ -170,7 +170,8 @@
 assign sel_ide   = hdc_ena && cpu_address_in[23:16]==8'b1101_1010;        //IDE registers at $DA0000 - $DAFFFF	
 assign sel_gayle = hdc_ena && cpu_address_in[23:12]==12'b1101_1110_0001;  //GAYLE registers at $DE1000 - $DE1FFF
 assign sel_rtc   = cpu_address_in[23:16]==8'b1101_1100;                   //RTC registers at $DC0000 - $DCFFFF
-assign sel_reg   = cpu_address_in[23:16]==8'b1101_1111;                   //chip registers at $DF0000 - $DFFFFF
+assign sel_reg   = cpu_address_in[23:16]==8'b1101_1111                    //chip registers at $DF0000 - $DFFFFF, and $C00000 - $D7FFFF without slow ram
+                || cpu_address_in[23:21]==3'b110 && cpu_address_in[20:19]!=2'b11 && ~|t_sel_slow;
 assign sel_cia   = cpu_address_in[23:16]==8'hBF; // $BFxxxx
 assign sel_cia_a = sel_cia & ~cpu_address_in[12];
 assign sel_cia_b = sel_cia & ~cpu_address_in[13];
